{
  "name": "repnix",
  "version": "1.0.2",
  "description": "Local-first repository health orchestration for JavaScript and TypeScript projects",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zakaihamilton/repnix.git"
  },
  "homepage": "https://github.com/zakaihamilton/repnix#readme",
  "bugs": {
    "url": "https://github.com/zakaihamilton/repnix/issues"
  },
  "type": "module",
  "main": "./dist/cli.js",
  "types": "./dist/cli.d.ts",
  "bin": {
    "repnix": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json && node scripts/make-executable.mjs",
    "lint": "eslint .",
    "prepack": "npm run build",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test:run",
    "test:e2e": "node scripts/e2e-consumer.mjs npm",
    "test:package": "node scripts/package-smoke.mjs",
    "test:phase2": "node scripts/e2e-phase2.mjs",
    "test:phase3": "node scripts/e2e-phase3.mjs",
    "test:compatibility": "node scripts/compatibility-pilot.mjs",
    "test:compatibility:oss": "node scripts/oss-compatibility-pilot.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "release:version": "pnpm changeset version && pnpm version:sync && pnpm install --lockfile-only && node scripts/release-check.mjs",
    "version:sync": "node scripts/sync-version.mjs",
    "format": "prettier --write .",
    "health": "node dist/cli.js check",
    "health:architecture": "depcruise --output-type json --config .dependency-cruiser.cjs -- src",
    "health:format": "prettier --check .",
    "health:security": "osv-scanner scan source --offline-vulnerabilities --format=json --recursive .",
    "health:secrets": "gitleaks detect --source . --no-banner --redact --exit-code 1",
    "health:ci": "actionlint",
    "health:tools:install": "bash scripts/install-health-tools.sh",
    "verify": "pnpm lint && pnpm typecheck && pnpm build && pnpm test:run && pnpm test:compatibility",
    "health:dead-code": "knip",
    "health:duplication": "jscpd src",
    "health:package:publint": "publint",
    "health:package:types": "attw --pack .",
    "health:coverage": "c8 --all --reporter=text pnpm run test",
    "health:licenses": "license-checker --json",
    "health:documentation": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#playwright-report\" \"#test-results\" \"#coverage\" \"#dist\" \"#build\" \"#.next\" \"#.turbo\" \"#.git\" \"#generated\"",
    "health:release": "node scripts/release-check.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.15.0",
  "keywords": [
    "repository",
    "health",
    "quality",
    "typescript",
    "javascript",
    "cli",
    "code-quality",
    "linting",
    "eslint",
    "testing",
    "vitest",
    "jest",
    "code-analysis",
    "static-analysis",
    "developer-tools",
    "ci",
    "github-actions",
    "monorepo",
    "workspace",
    "code-coverage",
    "security",
    "vulnerability",
    "dead-code",
    "code-review",
    "best-practices",
    "code-standards",
    "dependency-cruiser",
    "knip",
    "jscpd"
  ],
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "commander": "^14.0.0",
    "fast-glob": "^3.3.3",
    "ink": "^6.8.0",
    "jsonc-parser": "^3.3.1",
    "picocolors": "^1.1.1",
    "react": "^19.2.4",
    "yaml": "^2.8.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.11",
    "@types/react": "^19.2.13",
    "c8": "^12.0.0",
    "eslint": "^10.9.1",
    "jscpd": "^5.0.14",
    "knip": "^6.32.2",
    "license-checker": "^25.0.1",
    "markdownlint-cli2": "^0.23.2",
    "dependency-cruiser": "^17.2.0",
    "prettier": "^3.5.3",
    "publint": "^0.3.23",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^4.1.11"
  }
}
