{
  "name": "repnix",
  "version": "0.3.2",
  "description": "Local-first repository health orchestration for JavaScript and TypeScript projects",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zakaihamilton/repnix.git"
  },
  "homepage": "https://github.com/zakaihamilton/repnix#readme",
  "bugs": {
    "url": "https://github.com/zakaihamilton/repnix/issues"
  },
  "type": "module",
  "bin": {
    "repnix": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/make-executable.mjs",
    "lint": "eslint .",
    "prepack": "npm run build",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test:run",
    "test:e2e": "node scripts/e2e-consumer.mjs npm",
    "test:package": "node scripts/package-smoke.mjs",
    "test:phase2": "node scripts/e2e-phase2.mjs",
    "test:phase3": "node scripts/e2e-phase3.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "verify": "pnpm lint && pnpm typecheck && pnpm build && pnpm test:run"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.15.0",
  "keywords": [
    "repository",
    "health",
    "quality",
    "typescript",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "commander": "^14.0.0",
    "fast-glob": "^3.3.3",
    "jsonc-parser": "^3.3.1",
    "picocolors": "^1.1.1",
    "yaml": "^2.8.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^20.19.11",
    "eslint": "^9.34.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  }
}
